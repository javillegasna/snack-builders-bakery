ENVIRONMENT=development

LOG_LEVEL=INFO
LOG_JSON=true

OTEL_ENABLED=false
OTEL_SERVICE_NAME=bakery-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve:5080/api/default
OTEL_EXPORTER_OTLP_HEADERS=

POSTGRES_USER=bakery
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bakery
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# OpenObserve root credentials (used by docker-compose)
ZO_ROOT_USER_EMAIL=admin@bakery.local
ZO_ROOT_USER_PASSWORD=change-me
